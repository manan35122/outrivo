# Copy to .env and fill in. NEVER commit .env or your real key.

# Your group's Claude API key (from the email to the group leader)
ANTHROPIC_API_KEY=

# Model required by the hackathon
MODEL_NAME=claude-haiku-5-5

# Hosted Postgres (Supabase or Neon) connection string
DATABASE_URL=postgresql://user:password@host:5432/dbname

# Output cap for the main model. Must fit a tool call that carries several drafted emails.
MAX_OUTPUT_TOKENS=1200

# Agent limits per chat turn
MAX_TOOL_CALLS_PER_TURN=8
MAX_HISTORY_MESSAGES=12
MAX_HISTORY_TOKENS=4000
LLM_TIMEOUT_SECONDS=30

# send_outreach records messages as sent but does not dispatch anything real
SEND_MODE=simulate

# Budget guard. Prices: claude-haiku-5-5, USD per million tokens (prompts up to 100K tokens)
PRICE_IN_PER_MTOK=0.10
PRICE_OUT_PER_MTOK=0.50
# Stop taking requests when estimated total spend reaches this (the key's hard limit is $2)
BUDGET_HARD_LIMIT_USD=1.60
USER_DAILY_TOKEN_CAP=200000

# Request limits
RATE_LIMIT_USER_PER_MIN=30
RATE_LIMIT_IP_PER_MIN=300
MAX_MESSAGE_CHARS=2000
MAX_BODY_BYTES=16384

# Website only (Vercel): public URL of the agent API
NEXT_PUBLIC_AGENT_API_URL=http://localhost:8000
